#   cp .env.example .env   # 키 채운 뒤
#   ./scripts/run.sh
#   # 또는: flutter run --dart-define-from-file=.env
#
# 개별 플래그:
#   flutter run \
#     --dart-define=KAKAO_APP_KEY=your_kakao_js_key \
#     --dart-define=SEOUL_API_KEY=your_seoul_openapi_key \
#     --dart-define=SENTRY_DSN=  # optional

KAKAO_APP_KEY=
SEOUL_API_KEY=
SENTRY_DSN=
